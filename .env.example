CMC_API_KEY=
INGEST_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional: Telegram bot (see docs/submission-trading-alerts.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=
# Optional: lets the bot answer free-text questions (see docs/submission-mcp.md), via the Gemini API
# free tier (aistudio.google.com/apikey). Without it, every /command still works; free-text messages
# just reply that chat is switched off.
GEMINI_API_KEY=
# Optional overrides, both safe to leave unset:
# GEMINI_MODEL=gemini-3.1-flash-lite   # default; gemini-3.8-flash also works but its free tier is a hard 20 requests/day
# AGENT_CHAT_ENABLED=false   # kill switch: set to "false" to disable free-text chat without a code change
#
# Alternative model provider (lib/agent.ts's callAnthropic) — not used unless you wire it in yourself:
# ANTHROPIC_API_KEY=